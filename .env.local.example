# Shopify Storefront API
NEXT_PUBLIC_SHOPIFY_STORE_DOMAIN=your-store.myshopify.com
NEXT_PUBLIC_SHOPIFY_STOREFRONT_ACCESS_TOKEN=your-storefront-access-token
SHOPIFY_API_VERSION=2025-01
SHOPIFY_WEBHOOK_SECRET=

# Optional: public site URL for JSON-LD and journey links
NEXT_PUBLIC_SITE_URL=https://daakyka.com

# Optional: USD to INR conversion rate for display currency swap
NEXT_PUBLIC_USD_TO_INR_RATE=83

# Database — Postgres (local: docker compose up -d, then use URL below)
DATABASE_URL="postgresql://daakyka:daakyka@localhost:5432/daakyka_dev"

# Admin auth — the seed script only ever creates these users (never
# resets an existing password); pick your own values, not these examples.
# Generate a password with: openssl rand -base64 18
AUTH_SECRET=change-this-to-a-long-random-secret-in-production
ADMIN_SEED_EMAIL=admin@example.com
ADMIN_SEED_PASSWORD=replace-with-a-strong-random-password
# Optional: only created when both of these are set.
VIEWER_SEED_EMAIL=
VIEWER_SEED_PASSWORD=

# Email (Brevo)
BREVO_API_KEY=
BREVO_FROM_EMAIL=noreply@daakyka.com
BREVO_FROM_NAME=DAAKYKA Apparels

# WhatsApp (WATI)
WATI_API_KEY=
WATI_API_URL=https://live-server.wati.io
# Set true + template name for cold campaign outreach (outside 24h session window)
WATI_USE_TEMPLATES=false
WATI_BROADCAST_TEMPLATE=
WATI_BROADCAST_NAME=DAAKYKA Campaign

# Hermes Agent — Vercel inline runtime (recommended) or external HTTP runtime
HERMES_RUNTIME_INLINE=1
HERMES_LOCAL_URL=https://your-app.vercel.app/api/hermes/runtime
HERMES_API_KEY=generate-a-long-random-secret
# HERMES_API_URL=
HERMES_DEFAULT_MODE=SUGGEST_ONLY
# Fireworks powers Hermes LLM inference (server-only, never NEXT_PUBLIC_*)
FIREWORKS_API_KEY=

# AR Try-On microservice (MediaPipe + OpenCV — CPU, no GPU)
AR_TRYON_SERVICE_URL=http://localhost:8080
# Only enforced by the service when set — required once it's deployed
# somewhere reachable from outside your own network (see
# docs/DEPLOY_AR_TRYON.md); leave unset for local docker-compose use.
AR_TRYON_API_KEY=
NEXT_PUBLIC_OUTFIT_STUDIO=1

# Cron endpoints (/api/cron/journeys, /api/cron/hermes, /api/cron/campaigns, /api/cron/reports) — set in production
CRON_SECRET=

# AI image generation (OpenAI Images API) — server-only, never NEXT_PUBLIC_*.
# Everything works and reports "not configured" without this.
OPENAI_API_KEY=
OPENAI_IMAGE_MODEL=
AI_IMAGE_DAILY_LIMIT=50

# Cloudflare R2 storage (S3-compatible) for uploaded/AI-generated media.
# Everything works and reports "not configured" without these.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_BASE_URL=

# Staging: block search indexing (also auto-blocked on Vercel preview)
# NEXT_PUBLIC_ALLOW_INDEXING=false

# Local production simulation — enforce Vercel production env rules on build/start
# ENFORCE_PRODUCTION_ENV=1

# Razorpay native checkout (Phase D3) — server-only, never NEXT_PUBLIC_*.
# All three must be set together; checkout falls back to the
# order-request flow (no online payment) without them. Can also be set
# through /admin/integrations after deploy — a DB-set value always wins
# over these.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Root key for encrypting integration credentials (Razorpay/Brevo) stored
# via /admin/integrations, at rest in the DB. Required in production.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
CREDENTIAL_ENCRYPTION_KEY=
