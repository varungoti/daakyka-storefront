# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem
dev.db
ci.db
*.db-journal

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files — the *.example templates are meant to be committed so a
# fresh clone can `cp .env.local.example .env`; only real env files with
# actual secrets are ignored.
.env
.env.local
.env.*.local
.env.staging
.env.production
!.env*.example

# vercel
.vercel

# dogfood artifacts (screenshots, reports)
/dogfood-output/

# lighthouse-ci healthcheck/cache dir
/.lighthouseci/

# typescript
*.tsbuildinfo
next-env.d.ts

/src/generated/prisma

.vercel

__pycache__/
*.pyc

# local tunnel binary (scripts download on demand)
/bin/cloudflared.exe

