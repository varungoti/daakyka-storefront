# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem
dev.db
ci.db
*.db-journal

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files — the *.example templates are meant to be committed so a
# fresh clone can `cp .env.local.example .env`; only real env files with
# actual secrets are ignored.
#
# F-228 fix: this used to enumerate each real filename (.env, .env.local,
# .env.*.local, .env.staging, .env.production) with the !.env*.example
# negation last — but a second, broader `.env*` rule further down this
# file (with no negation after it) came later in file order and silently
# overrode that negation for git's "last matching line wins" rule, so any
# *new* .env*.example template would have been gitignored on `git add`
# instead of committed. One broad rule with the negation immediately after
# it removes that trap and still covers every .env variant, present or
# future.
.env*
!.env*.example

# vercel
.vercel

# dogfood artifacts (screenshots, reports)
/dogfood-output/

# F-303: internal-only docs (security audit detail, etc.) that must never
# be served from the public repo — see docs/internal/README.md. Keeping
# this local-only is the relocation half of F-303; whether the whole repo
# should be private too is a separate, owner-only decision.
/docs/internal/

# lighthouse-ci healthcheck/cache dir
/.lighthouseci/

# typescript
*.tsbuildinfo
next-env.d.ts

/src/generated/prisma

.vercel

__pycache__/
*.pyc

# local tunnel binary (scripts download on demand)
/bin/cloudflared.exe

# Personal Claude Code settings (not shared with the team)
.claude/settings.local.json
