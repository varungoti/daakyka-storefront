# Staging environment template
# Copy values into Vercel → Settings → Environment Variables (Preview/Staging)

DATABASE_URL=postgresql://user:password@host:5432/daakyka_staging?sslmode=require
AUTH_SECRET=replace-with-32-plus-character-random-secret
NEXT_PUBLIC_SITE_URL=https://your-project.vercel.app
NEXT_PUBLIC_ALLOW_INDEXING=false
CRON_SECRET=replace-with-staging-cron-bearer-token
ADMIN_SEED_EMAIL=admin@example.com
ADMIN_SEED_PASSWORD=replace-with-strong-password

# Optional — leave empty for demo mode (seed catalog + local cart)
NEXT_PUBLIC_SHOPIFY_STORE_DOMAIN=
NEXT_PUBLIC_SHOPIFY_STOREFRONT_ACCESS_TOKEN=
SHOPIFY_API_VERSION=2025-01
SHOPIFY_WEBHOOK_SECRET=

# Optional: only created when both of these are set.
VIEWER_SEED_EMAIL=
VIEWER_SEED_PASSWORD=

# Optional: USD to INR conversion rate for display currency swap
NEXT_PUBLIC_USD_TO_INR_RATE=83

# Optional integrations (use sandbox/test keys only on staging)
BREVO_API_KEY=
BREVO_FROM_EMAIL=noreply@daakyka.com
BREVO_FROM_NAME=DAAKYKA Apparels
WATI_API_KEY=
WATI_API_URL=https://live-server.wati.io
# Set true + template name for cold campaign outreach (outside 24h session window)
WATI_USE_TEMPLATES=false
WATI_BROADCAST_TEMPLATE=
WATI_BROADCAST_NAME=DAAKYKA Campaign
HERMES_API_URL=
HERMES_LOCAL_URL=https://your-project.vercel.app/api/hermes/runtime
HERMES_RUNTIME_INLINE=1
HERMES_API_KEY=replace-with-staging-hermes-bearer-token
HERMES_DEFAULT_MODE=SUGGEST_ONLY
FIREWORKS_API_KEY=

# Mix & Match Studio (MediaPipe AR try-on)
NEXT_PUBLIC_OUTFIT_STUDIO=1
# Public URL of services/ar-tryon (Railway/Fly). Omit for garment-preview fallback.
AR_TRYON_SERVICE_URL=
# Required once AR_TRYON_SERVICE_URL points at a publicly reachable
# deployment — set the same value in that service's own environment.
AR_TRYON_API_KEY=
