{
  "buildCommand": "node scripts/vercel-build.mjs",
  "installCommand": "npm ci",
  "regions": ["hnd1"],
  "functions": {
    "src/app/api/hermes/runtime/tasks/route.ts": {
      "maxDuration": 60
    },
    "src/app/api/cron/hermes/route.ts": {
      "maxDuration": 120
    },
    "src/app/api/outfit/try-on/route.ts": {
      "maxDuration": 120
    },
    "src/app/api/admin/media/generate/route.ts": {
      "maxDuration": 120
    },
    "src/app/api/cron/journeys/route.ts": {
      "maxDuration": 300
    },
    "src/app/api/cron/campaigns/route.ts": {
      "maxDuration": 300
    },
    "src/app/api/cron/retention/route.ts": {
      "maxDuration": 60
    }
  },
  "crons": [
    {
      "path": "/api/cron/journeys",
      "schedule": "*/15 * * * *"
    },
    {
      "path": "/api/cron/hermes",
      "schedule": "0 6 * * *"
    },
    {
      "path": "/api/cron/reports",
      "schedule": "0 7 * * 1"
    },
    {
      "path": "/api/cron/campaigns",
      "schedule": "*/15 * * * *"
    },
    {
      "path": "/api/cron/cancel-stale-orders",
      "schedule": "*/15 * * * *"
    },
    {
      "path": "/api/cron/drain-email-outbox",
      "schedule": "*/15 * * * *"
    },
    {
      "path": "/api/cron/back-in-stock",
      "schedule": "*/15 * * * *"
    },
    {
      "path": "/api/cron/retention",
      "schedule": "30 3 * * *"
    }
  ]
}
