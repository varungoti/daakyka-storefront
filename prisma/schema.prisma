generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum AdminRole {
  SUPER_ADMIN
  STORE_OWNER
  MARKETING_ADMIN
  SEO_MANAGER
  CONTENT_EDITOR
  BULK_ORDER_MANAGER
  CATALOG_MANAGER
  ORDER_MANAGER
  SUPPORT_AGENT
  VIEWER
}

enum BulkLeadStatus {
  NEW
  CONTACTED
  QUOTED
  WON
  LOST
}

enum BlogStatus {
  DRAFT
  PUBLISHED
}

enum TemplateChannel {
  EMAIL
  WHATSAPP
}

enum CampaignStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  SCHEDULED
  // engagement_compliance: claimed by a dispatch run (see
  // src/lib/engagement/campaign-dispatcher.ts claimCampaignForSending) so a
  // second overlapping cron/admin trigger can't send the same campaign twice.
  SENDING
  SENT
  // engagement_compliance: every recipient attempt failed (0 CampaignDelivery
  // rows with status "sent"). Distinct from CANCELLED (never sent, admin
  // choice) so a failed send can be diagnosed and requeued.
  FAILED
  CANCELLED
}

enum ContactEnquiryType {
  GENERAL
  BULK_ORDER
  INSTITUTIONAL
  SUPPORT
}

enum JourneyStatus {
  DRAFT
  ACTIVE
  PAUSED
}

enum JourneyStepChannel {
  EMAIL
  WHATSAPP
  ADMIN_NOTIFICATION
}

enum HermesTaskStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
}

enum HermesApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

enum IntegrationProvider {
  BREVO
  WATI
  SHOPIFY
  HERMES
}

enum EnrollmentStatus {
  ACTIVE
  COMPLETED
  CANCELLED
}

model User {
  id                  String        @id @default(cuid())
  email               String        @unique
  name                String
  passwordHash        String
  role                AdminRole     @default(VIEWER)
  active              Boolean       @default(true)
  sessionVersion      Int           @default(0)
  failedLoginCount    Int           @default(0)
  lockedUntil         DateTime?
  lastFailedLoginAt   DateTime?
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt
  auditLogs           AuditLog[]
  productsCreated     Product[]
  mediaAssetsCreated  MediaAsset[]
  reviewsModerated    Review[]
  siteSettingsUpdated SiteSetting[]
  integrationCredentialsUpdated IntegrationCredential[]
  discountsCreated    Discount[]
}

/// DB-backed rate limit buckets (v1 2.1). Replaces the old in-memory Map so
/// limits are enforced consistently across serverless instances. `key` is
/// `${route}:${ip}`; `count`/`resetAt` are updated atomically via a raw
/// upsert in src/lib/security/rate-limit.ts.
model RateLimitBucket {
  key     String   @id
  count   Int
  resetAt DateTime

  @@index([resetAt])
}

model BulkOrderLead {
  id               String         @id @default(cuid())
  organization     String
  contactPerson    String
  email            String
  phone            String
  city             String?
  staffCount       Int?
  productsRequired String?
  colorsRequired   String?
  sizesRequired    String?
  logoEmbroidery   Boolean        @default(false)
  deliveryTimeline String?
  notes            String?
  status           BulkLeadStatus @default(NEW)
  consentGiven     Boolean        @default(false)
  // Phase C7: which kind of organisation is enquiring, and which product
  // categories they're interested in. Both nullable/defaulted so existing
  // rows and older client payloads that omit them keep working.
  organizationType String?
  categoryInterest String[]       @default([])
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
}

model HomepageSection {
  id        String   @id @default(cuid())
  key       String   @unique
  title     String
  enabled   Boolean  @default(true)
  sortOrder Int      @default(0)
  content   String
  updatedAt DateTime @updatedAt
}

model BlogPostRecord {
  id          String     @id @default(cuid())
  slug        String     @unique
  title       String
  excerpt     String
  category    String
  author      String
  publishedAt DateTime
  readTime    String
  image       String
  content     String
  status      BlogStatus @default(DRAFT)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action    String
  entity    String
  entityId  String?
  metadata  String?
  createdAt DateTime @default(now())
}

model NewsletterSubscriber {
  id           String   @id @default(cuid())
  email        String   @unique
  source       String   @default("footer")
  // engagement_compliance: was `@default(true)`, which meant a subscriber
  // got marketing consent by default with no actual checkbox interaction —
  // flagged in the compliance audit as a real bug. New rows now start
  // unconsented until the API-level zod check (newsletterSchema requires
  // consentGiven: true) and the UI checkbox both confirm it.
  consentGiven Boolean  @default(false)
  // engagement_compliance: double opt-in. Set only once the confirmation
  // link (GET /api/newsletter/confirm?token=...) is followed; nothing is
  // sent to a subscriber (and no journey is triggered) until this is set.
  confirmedAt  DateTime?
  // engagement_compliance: single-use, cleared once consumed by the confirm
  // route. Null once confirmed or if a subscriber was created before this
  // migration and hasn't re-subscribed since.
  confirmToken String?  @unique
  // engagement_compliance: set when the subscriber unsubscribes; every
  // marketing-segment query and sendMarketingEmail() must exclude these.
  unsubscribedAt DateTime?
  // engagement_compliance: stable, unguessable per-subscriber token used by
  // the unsubscribe link/footer on every marketing email. Never rotated so
  // an old email's unsubscribe link keeps working.
  unsubscribeToken String @unique @default(cuid())
  createdAt    DateTime @default(now())
}

model CustomerSegment {
  id          String     @id @default(cuid())
  name        String
  slug        String     @unique
  description String?
  criteria    String
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  campaigns   Campaign[]
}

model MessageTemplate {
  id           String          @id @default(cuid())
  name         String
  channel      TemplateChannel
  subject      String?
  body         String
  variables    String?
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  campaigns    Campaign[]
  journeySteps JourneyStep[]
}

model Campaign {
  id          String           @id @default(cuid())
  name        String
  channel     TemplateChannel
  status      CampaignStatus   @default(DRAFT)
  segmentId   String?
  segment     CustomerSegment? @relation(fields: [segmentId], references: [id], onDelete: SetNull)
  templateId  String?
  template    MessageTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)
  scheduledAt DateTime?
  notes       String?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  deliveries  CampaignDelivery[]
}

/// engagement_compliance: one row per (campaign, recipient, channel) send
/// attempt. The unique constraint is what makes a campaign send idempotent
/// — campaign-dispatcher.ts checks for an existing row before sending and
/// relies on the constraint as a second line of defense against a race
/// creating two rows for the same recipient, so an interrupted dispatch run
/// can resume without double-sending.
model CampaignDelivery {
  id                String          @id @default(cuid())
  campaignId        String
  campaign          Campaign        @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  recipient         String
  channel           TemplateChannel
  status            String
  providerMessageId String?
  error             String?
  sentAt            DateTime?
  createdAt         DateTime        @default(now())

  @@unique([campaignId, recipient, channel])
  @@index([campaignId])
}

/// engagement_compliance: WhatsApp marketing opt-in/out, separate from
/// NewsletterSubscriber because a lead can opt into WhatsApp updates
/// without subscribing to the email newsletter (and vice versa). Consulted
/// before a WATI marketing/broadcast send; transactional WhatsApp
/// (order updates, OTPs) is unaffected.
model WhatsAppOptIn {
  id          String    @id @default(cuid())
  phone       String    @unique
  optedInAt   DateTime  @default(now())
  optedOutAt  DateTime?
}

/// engagement_compliance: one row per (job, runKey) cron execution. The
/// unique constraint on (job, runKey) is the idempotency mechanism —
/// creating this row is the "claim"; a duplicate cron trigger for the same
/// job+window hits a unique-constraint violation and short-circuits
/// instead of redoing the work. See src/lib/cron/idempotency.ts.
model CronRun {
  id        String   @id @default(cuid())
  job       String
  runKey    String
  createdAt DateTime @default(now())

  @@unique([job, runKey])
}

model TestimonialRecord {
  id        String   @id @default(cuid())
  quote     String
  name      String
  title     String
  rating    Int      @default(5)
  avatar    String
  featured  Boolean  @default(false)
  active    Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ContactEnquiry {
  id           String             @id @default(cuid())
  name         String
  email        String
  phone        String?
  organization String?
  type         ContactEnquiryType @default(GENERAL)
  message      String
  status       String             @default("NEW")
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt
}

model CustomerJourney {
  id          String              @id @default(cuid())
  name        String
  slug        String              @unique
  description String?
  trigger     String
  status      JourneyStatus       @default(DRAFT)
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
  steps       JourneyStep[]
  events      JourneyEvent[]
  enrollments JourneyEnrollment[]
}

model JourneyStep {
  id         String             @id @default(cuid())
  journeyId  String
  journey    CustomerJourney    @relation(fields: [journeyId], references: [id], onDelete: Cascade)
  sortOrder  Int
  name       String
  delayHours Int                @default(0)
  channel    JourneyStepChannel
  templateId String?
  template   MessageTemplate?   @relation(fields: [templateId], references: [id], onDelete: SetNull)
  notes      String?
  createdAt  DateTime           @default(now())
  updatedAt  DateTime           @updatedAt
}

model IntegrationSetting {
  id        String              @id @default(cuid())
  provider  IntegrationProvider @unique
  enabled   Boolean             @default(false)
  config    String              @default("{}")
  updatedAt DateTime            @updatedAt
}

enum CredentialProvider {
  RAZORPAY
  BREVO
}

/// Admin-settable third-party credentials (Razorpay keys, Brevo API key),
/// so a live deploy can be given real credentials through the admin UI
/// without a redeploy or hosting-platform env var change. `valueEncrypted`
/// is always AES-256-GCM ciphertext (see src/lib/integrations/credential-store.ts)
/// even for non-secret sub-fields like BREVO/FROM_EMAIL — one encrypt/decrypt
/// code path with no plaintext branch is less error-prone than special-casing
/// "this field doesn't need it". Every read site checks this table first and
/// falls back to process.env, so an env-var-only deploy keeps working.
model IntegrationCredential {
  id             String              @id @default(cuid())
  provider       CredentialProvider
  key            String
  valueEncrypted String
  updatedById    String?
  updatedBy      User?               @relation(fields: [updatedById], references: [id], onDelete: SetNull)
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  @@unique([provider, key])
}

model HermesTask {
  id          String           @id @default(cuid())
  type        String
  status      HermesTaskStatus @default(PENDING)
  mode        String           @default("SUGGEST_ONLY")
  input       String?
  output      String?
  createdAt   DateTime         @default(now())
  completedAt DateTime?
  approvals   HermesApproval[]
}

model HermesApproval {
  id         String               @id @default(cuid())
  taskId     String?
  task       HermesTask?          @relation(fields: [taskId], references: [id], onDelete: SetNull)
  type       String
  title      String
  summary    String
  payload    String
  status          HermesApprovalStatus @default(PENDING)
  reviewedBy      String?
  reviewedAt      DateTime?
  executionResult Json?
  createdAt       DateTime             @default(now())
}

model JourneyEvent {
  id        String          @id @default(cuid())
  journeyId String
  journey   CustomerJourney @relation(fields: [journeyId], references: [id], onDelete: Cascade)
  stepId    String?
  trigger   String
  channel   String
  recipient String?
  status    String          @default("queued")
  metadata  String?
  createdAt DateTime        @default(now())
}

model AdminNotification {
  id        String   @id @default(cuid())
  title     String
  body      String
  type      String
  read      Boolean  @default(false)
  metadata  String?
  createdAt DateTime @default(now())
}

model SeoPageRecord {
  id              String   @id @default(cuid())
  path            String   @unique
  title           String
  metaDescription String
  h1              String?
  status          String   @default("ok")
  issues          String?
  updatedAt       DateTime @updatedAt
}

model OfferRecommendation {
  id          String   @id @default(cuid())
  name        String
  type        String
  description String
  active      Boolean  @default(true)
  config      String   @default("{}")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model MarketSnapshot {
  id          String   @id @default(cuid())
  competitor  String
  category    String
  observation String
  capturedAt  DateTime @default(now())
}

model JourneyEnrollment {
  id          String           @id @default(cuid())
  journeyId   String
  journey     CustomerJourney  @relation(fields: [journeyId], references: [id], onDelete: Cascade)
  email       String?
  phone       String?
  currentStep Int              @default(0)
  context     String           @default("{}")
  nextRunAt   DateTime?
  status      EnrollmentStatus @default(ACTIVE)
  trigger     String
  // engagement_compliance: claim marker for processDueEnrollments — a cron
  // run sets this before executing a step and clears it after, so a second
  // overlapping cron run skips rows already claimed (see
  // src/lib/engagement/journey-engine.ts). A stale lock (older than the
  // claim timeout) is treated as unclaimed so a crashed run doesn't wedge
  // an enrollment forever.
  lockedAt    DateTime?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  // engagement_compliance: NOT a `@@unique([journeyId, email])` — verified
  // against production data that no duplicate (journeyId, email) rows exist
  // today, but a hard unique constraint would still be wrong: triggers like
  // cart_abandoned/order_created/bulk_lead_created legitimately re-enroll
  // the same email in the same journey over time (a second abandoned cart,
  // a second order), so only *simultaneously ACTIVE* duplicates should be
  // blocked. That's enforced with a partial unique index added by raw SQL
  // in the engagement_compliance migration (`... WHERE status = 'ACTIVE'`,
  // which Prisma's schema DSL can't express) plus an application-level
  // check in journey-engine.ts's enrollInJourney. This index is only for
  // query performance/documentation.
  @@index([journeyId, email])
  @@index([nextRunAt, status])
}

model CartAbandonmentEvent {
  id        String   @id @default(cuid())
  email     String?
  cartId    String?
  subtotal  Float?
  itemCount Int      @default(0)
  metadata  String?
  recovered Boolean  @default(false)
  createdAt DateTime @default(now())
}

model OrderEvent {
  id         String   @id @default(cuid())
  externalId String?  @unique
  email      String?
  phone      String?
  total      Float?
  status     String   @default("created")
  source     String   @default("shopify")
  metadata   String?
  createdAt  DateTime @default(now())
}

model ProductViewEvent {
  id            String   @id @default(cuid())
  productHandle String
  productName   String?
  sessionId     String?
  createdAt     DateTime @default(now())

  @@index([productHandle, createdAt])
}

// ---------------------------------------------------------------------------
// catalog_commerce_v1 — native catalog, customers, reviews, orders, settings
// ---------------------------------------------------------------------------

enum CategorySection {
  HOSPITAL
  SCHOOL
  KIDS
  GENERAL
}

enum ProductStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum ProductGender {
  MEN
  WOMEN
  UNISEX
  BOYS
  GIRLS
  KIDS
}

enum MediaSource {
  UPLOAD
  AI
}

enum MediaUsage {
  PRODUCT
  CATEGORY
  BANNER
  SECTION
  BLOG
  AVATAR
  REVIEW
}

enum SizeUnit {
  IN
  CM
}

enum CustomerTokenType {
  VERIFY
  RESET
}

enum ReviewStatus {
  PENDING
  APPROVED
  REJECTED
}

enum OrderStatus {
  PENDING_PAYMENT
  PAID
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
  REFUNDED
}

enum DiscountType {
  PERCENTAGE
  FIXED
}

enum PaymentMethod {
  RAZORPAY
  ORDER_REQUEST
}

enum ShopifySyncStatus {
  NOT_SYNCED
  PENDING
  SYNCED
  ERROR
}

model Category {
  id             String          @id @default(cuid())
  slug           String          @unique
  name           String
  description    String?
  section        CategorySection @default(GENERAL)
  parentId       String?
  parent         Category?       @relation("CategoryHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children       Category[]      @relation("CategoryHierarchy")
  imageId        String?
  image          MediaAsset?     @relation(fields: [imageId], references: [id], onDelete: SetNull)
  sortOrder      Int             @default(0)
  active         Boolean         @default(true)
  showInMenu     Boolean         @default(true)
  sizeChartId    String?
  sizeChart      SizeChart?      @relation(fields: [sizeChartId], references: [id], onDelete: SetNull)
  seoTitle       String?
  seoDescription String?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  products       Product[]

  @@index([section])
  @@index([parentId])
}

model Product {
  id                String            @id @default(cuid())
  slug              String            @unique
  name              String
  shortDescription  String?
  description       String?
  categoryId        String
  category          Category          @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  status            ProductStatus     @default(DRAFT)
  featured          Boolean           @default(false)
  isNew             Boolean           @default(false)
  price             Decimal           @db.Decimal(10, 2)
  compareAtPrice    Decimal?          @db.Decimal(10, 2)
  gender            ProductGender     @default(UNISEX)
  fabric            String?
  care              String?
  tags              String[]
  sizeChartId       String?
  sizeChart         SizeChart?        @relation(fields: [sizeChartId], references: [id], onDelete: SetNull)
  seoTitle          String?
  seoDescription    String?
  shopifyProductId  String?
  shopifySyncStatus ShopifySyncStatus @default(NOT_SYNCED)
  shopifySyncedAt   DateTime?
  createdById       String?
  createdBy         User?             @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  variants          ProductVariant[]
  images            ProductImage[]
  reviews           Review[]
  wishlistItems     WishlistItem[]
  backInStockSubscriptions BackInStockSubscription[]

  @@index([status, categoryId])
  @@index([featured])
}

model ProductVariant {
  id               String      @id @default(cuid())
  productId        String
  product          Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  sku              String      @unique
  size             String
  color            String
  colorHex         String?
  price            Decimal?    @db.Decimal(10, 2)
  stock            Int         @default(0)
  active           Boolean     @default(true)
  shopifyVariantId String?
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt
  orderItems       OrderItem[]
  backInStockSubscriptions BackInStockSubscription[]

  @@unique([productId, size, color])
}

model ProductImage {
  id        String     @id @default(cuid())
  productId String
  product   Product    @relation(fields: [productId], references: [id], onDelete: Cascade)
  mediaId   String
  media     MediaAsset @relation(fields: [mediaId], references: [id], onDelete: Cascade)
  color     String?
  sortOrder Int        @default(0)
  alt       String?
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  @@index([productId, color])
}

model MediaAsset {
  id            String         @id @default(cuid())
  key           String         @unique
  url           String
  alt           String?
  width         Int?
  height        Int?
  source        MediaSource    @default(UPLOAD)
  prompt        String?
  model         String?
  usage         MediaUsage
  slot          String?        @unique
  createdById   String?
  createdBy     User?          @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  categories    Category[]
  productImages ProductImage[]

  @@index([usage])
}

model SizeChart {
  id         String     @id @default(cuid())
  name       String
  unit       SizeUnit   @default(IN)
  columns    Json
  rows       Json
  notes      String?
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt
  categories Category[]
  products   Product[]
}

model Customer {
  id               String            @id @default(cuid())
  email            String            @unique
  name             String
  phone            String?
  passwordHash     String
  emailVerifiedAt  DateTime?
  sessionVersion   Int               @default(0)
  active           Boolean           @default(true)
  failedLoginCount Int               @default(0)
  lockedUntil      DateTime?
  lastFailedLoginAt DateTime?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  addresses        CustomerAddress[]
  tokens           CustomerToken[]
  reviews          Review[]
  orders           Order[]
  wishlistItems    WishlistItem[]
}

model CustomerAddress {
  id         String   @id @default(cuid())
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  label      String?
  line1      String
  line2      String?
  city       String
  state      String
  postalCode String
  country    String   @default("IN")
  phone      String?
  isDefault  Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([customerId])
}

model CustomerToken {
  id         String            @id @default(cuid())
  customerId String
  customer   Customer          @relation(fields: [customerId], references: [id], onDelete: Cascade)
  type       CustomerTokenType
  tokenHash  String            @unique
  expiresAt  DateTime
  usedAt     DateTime?
  createdAt  DateTime          @default(now())

  @@index([customerId, type])
}

model Review {
  id               String       @id @default(cuid())
  productId        String
  product          Product      @relation(fields: [productId], references: [id], onDelete: Cascade)
  customerId       String
  customer         Customer     @relation(fields: [customerId], references: [id], onDelete: Cascade)
  rating           Int
  title            String?
  body             String
  photoIds         String[]
  status           ReviewStatus @default(PENDING)
  verifiedPurchase Boolean      @default(false)
  moderatedById    String?
  moderatedBy      User?        @relation(fields: [moderatedById], references: [id], onDelete: SetNull)
  moderatedAt      DateTime?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  @@unique([productId, customerId])
  @@index([status])
}

model Order {
  id                String        @id @default(cuid())
  number            String        @unique
  // Phase G / F2 fix: hash of the high-entropy capability token that lets a
  // guest (no customer session) view their own order at /order/[number].
  // Nullable so pre-existing seeded orders without a token still load
  // (they simply can't be viewed by a guest until re-issued); NULL values
  // never collide under the unique constraint (Postgres treats each NULL
  // as distinct). See src/lib/orders/access-token.ts and get-order.ts.
  accessTokenHash   String?       @unique
  customerId        String?
  customer          Customer?     @relation(fields: [customerId], references: [id], onDelete: SetNull)
  email             String
  phone             String?
  shippingAddress   Json
  subtotal          Decimal       @db.Decimal(10, 2)
  shipping          Decimal       @db.Decimal(10, 2)
  discount          Decimal       @default(0) @db.Decimal(10, 2)
  total             Decimal       @db.Decimal(10, 2)
  currency          String        @default("INR")
  status            OrderStatus   @default(PENDING_PAYMENT)
  paymentMethod     PaymentMethod @default(RAZORPAY)
  razorpayOrderId   String?
  razorpayPaymentId String?
  trackingNumber    String?
  courier           String?
  notes             String?
  adminNotes        String?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  items             OrderItem[]
  // Release-hardening F7 (discount codes at checkout): `discountId` is the
  // discount actually priced into `discount`/`total` above, computed
  // server-side (see src/lib/discounts/index.ts's resolveDiscount) —
  // never trusted from the client. `discountCode` snapshots the code text
  // at the time it was applied (same "never rely on a live join for
  // historical display" convention as OrderItem's productName/sku
  // snapshots) so an order's summary/emails/admin view keep reading
  // correctly even if the Discount row is later edited. Set at creation
  // for BOTH payment methods so pricing/Razorpay-amount is always correct,
  // but the redemption itself (DiscountRedemption row + Discount.redeemedCount)
  // is only ever committed — via commitDiscountRedemption — immediately for
  // an ORDER_REQUEST order or at PAID time for a RAZORPAY order; see that
  // function's doc comment for why.
  discountId        String?
  appliedDiscount   Discount?     @relation(fields: [discountId], references: [id], onDelete: SetNull)
  discountCode      String?
  discountRedemption DiscountRedemption?

  @@index([status])
  @@index([customerId])
  @@index([discountId])
}

model OrderItem {
  id           String          @id @default(cuid())
  orderId      String
  order        Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  variantId    String?
  variant      ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)
  productName  String
  variantLabel String?
  sku          String?
  unitPrice    Decimal         @db.Decimal(10, 2)
  quantity     Int
  imageUrl     String?
  createdAt    DateTime        @default(now())

  @@index([orderId])
}

model SiteSetting {
  id          String   @id @default(cuid())
  key         String   @unique
  value       Json
  updatedById String?
  updatedBy   User?    @relation(fields: [updatedById], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model WishlistItem {
  id         String   @id @default(cuid())
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  productId  String
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@unique([customerId, productId])
}

enum EmailOutboxStatus {
  PENDING
  SENT
  FAILED
}

/// F7 fix (docs/audit-2026-09-19/correctness.md): durable transactional-email
/// outbox. Every sendTransactionalEmail() attempt (src/lib/engagement/
/// outbox.ts) — order confirmations, account verify/reset links, etc. — is
/// persisted here, so a Brevo-unconfigured or Brevo-erroring send is
/// recorded and retryable instead of only ever reaching a console.log.
/// `to`/`subject`/`html`/`text`/`headers` mirror providers/email.ts's
/// SendEmailInput exactly, so a queued row can be replayed faithfully by
/// the drain cron without a parallel templating system. NOT used for
/// marketing email (campaigns/journeys) — those already have their own
/// consent-gated CampaignDelivery/JourneyEvent audit trail and must never
/// be replayed without re-checking consent at send time; see
/// src/lib/engagement/send-marketing-email.ts.
model EmailOutbox {
  id                String            @id @default(cuid())
  to                String
  subject           String
  html              String
  text              String?
  /// JSON-stringified Record<string,string> — mirrors SendEmailInput.headers.
  /// In practice always null for this transactional-only outbox today (only
  /// sendMarketingEmail sets headers), kept for full fidelity with the send
  /// path this replays.
  headers           String?
  /// Short machine-readable tag (see EMAIL_KIND in src/lib/engagement/
  /// outbox.ts) — "order_confirmation_customer", "customer_verify_email",
  /// etc. Plain string rather than an enum since this set is expected to
  /// grow with new transactional flows, matching JourneyEvent.channel's
  /// precedent elsewhere in this schema.
  kind              String
  status            EmailOutboxStatus @default(PENDING)
  /// Count of real attempts against an actually-configured provider only —
  /// a result of provider:"stub" (Brevo simply not configured) never
  /// increments this, so an indefinitely-unconfigured Brevo doesn't burn
  /// through the retry budget; see computeBackoffMs()/MAX_ATTEMPTS.
  attemptCount      Int               @default(0)
  lastError         String?
  providerMessageId String?
  /// Null = eligible for the next drain run immediately. Set to a future
  /// time after a real provider-level failure (exponential backoff).
  nextAttemptAt     DateTime?
  /// Claim marker for drainEmailOutbox, same stale-lock-reclaim pattern as
  /// JourneyEnrollment.lockedAt (see src/lib/engagement/journey-engine.ts)
  /// so two overlapping cron runs can't double-send the same row.
  lockedAt          DateTime?
  sentAt            DateTime?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  @@index([status, nextAttemptAt])
  @@index([kind])
}

// ---------------------------------------------------------------------------
// release-hardening F7 — discount codes (docs/audit-2026-09-19/storefront-ux.md)
// ---------------------------------------------------------------------------

/// A redeemable coupon code. `code` is stored normalized (trimmed +
/// uppercased — see normalizeDiscountCode in src/lib/discounts/index.ts) so
/// the plain `@unique` below enforces case-insensitive uniqueness without a
/// citext extension; every write path must normalize before insert/lookup.
model Discount {
  id                        String       @id @default(cuid())
  code                      String       @unique
  type                      DiscountType
  /// Percentage points (0-100) when type=PERCENTAGE, or a flat INR amount
  /// when type=FIXED. Never read from the client at checkout — always
  /// looked up fresh from this row (see resolveDiscount).
  value                     Decimal      @db.Decimal(10, 2)
  /// Cart subtotal (pre-discount) must be >= this to use the code. Null =
  /// no minimum.
  minSubtotal               Decimal?     @db.Decimal(10, 2)
  /// Total redemptions allowed across all customers. Null = unlimited.
  maxRedemptions            Int?
  /// Redemptions allowed per customer/email. Null = unlimited.
  maxRedemptionsPerCustomer Int?
  /// Authoritative counter. Only ever incremented via the conditional
  /// `updateMany` compare-and-swap in commitDiscountRedemption — the same
  /// pattern already used for ProductVariant.stock and the Order PAID
  /// transition (see /api/checkout/verify) — never via a naive
  /// read-then-write, so a capped code can't over-redeem under concurrent
  /// checkouts.
  redeemedCount             Int          @default(0)
  startsAt                  DateTime?
  endsAt                    DateTime?
  active                    Boolean      @default(true)
  createdById               String?
  createdBy                 User?        @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdAt                 DateTime     @default(now())
  updatedAt                 DateTime     @updatedAt
  orders                    Order[]
  redemptions               DiscountRedemption[]

  @@index([active])
}

/// One row per COMMITTED redemption (never per attempt) — created only by
/// commitDiscountRedemption, at the same moment redeemedCount is
/// incremented. `orderId` is unique so an order can never redeem twice;
/// (discountId, email) backs the per-customer cap check.
model DiscountRedemption {
  id         String   @id @default(cuid())
  discountId String
  discount   Discount @relation(fields: [discountId], references: [id], onDelete: Cascade)
  orderId    String   @unique
  order      Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  /// Normalized lowercase — matches the checkout email exactly (guest
  /// checkout has no customerId to key off).
  email      String
  customerId String?
  createdAt  DateTime @default(now())

  @@index([discountId, email])
}

// ---------------------------------------------------------------------------
// release-hardening — back-in-stock notifications (docs/audit-2026-09-19/storefront-ux.md)
// ---------------------------------------------------------------------------

/// "Notify me when available" capture for a sold-out ProductVariant.
/// Restock detection is a periodic cron sweep (src/app/api/cron/
/// back-in-stock/route.ts), not a hook at every stock-writing call site —
/// see that route's doc comment for why. A pending (notifiedAt: null) row
/// can only ever have been created while the variant's stock was <= 0
/// (enforced server-side at signup — see subscribeToBackInStock), so
/// "pending subscription + variant.stock now > 0" IS the 0->positive
/// transition; no extra bookkeeping column is needed on ProductVariant.
model BackInStockSubscription {
  id         String         @id @default(cuid())
  productId  String
  product    Product        @relation(fields: [productId], references: [id], onDelete: Cascade)
  variantId  String
  variant    ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  /// Normalized lowercase — see subscribeToBackInStock.
  email      String
  createdAt  DateTime       @default(now())
  /// Set the moment the restock email is handed to sendTransactionalEmail
  /// (queued, not necessarily delivered) — that's when this subscription is
  /// considered "consumed"; see sweepBackInStock. Null = still pending.
  /// Also doubles as the claim marker: sweepBackInStock only ever sets it
  /// via a conditional `updateMany` (notifiedAt: null -> now), the same
  /// compare-and-swap idiom used everywhere else in this schema, so an
  /// overlapping sweep run can't notify the same subscription twice.
  notifiedAt DateTime?

  // A given email can only have one PENDING subscription per variant — see
  // the partial unique index added by raw SQL in this feature's migration
  // (`... WHERE "notifiedAt" IS NULL`, mirroring JourneyEnrollment's own
  // partial-unique-index precedent elsewhere in this schema; Prisma's
  // schema DSL can't express a partial index). Once notified, the same
  // email may sign up again for a future restock cycle. This index is only
  // for query performance/documentation.
  @@index([variantId, notifiedAt])
  @@index([email])
}
